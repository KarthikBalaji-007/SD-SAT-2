# ==============================================================================
# ConnectSphere Environment Configuration Template
# DO NOT commit real secrets or production credentials to version control.
# Copy this file to .env for local development.
# ==============================================================================

# Application Environment
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:4000

# PostgreSQL (Relational store for users, follows, posts, comments, reactions, outbox)
POSTGRES_USER=connectsphere_user
POSTGRES_PASSWORD=connectsphere_dev_password
POSTGRES_DB=connectsphere_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://connectsphere_user:connectsphere_dev_password@localhost:5432/connectsphere_db?schema=public

# MongoDB (Document store for conversations, messages, notifications)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo_dev_password
MONGO_DB=connectsphere_chat
MONGO_PORT=27017
MONGODB_URI=mongodb://root:mongo_dev_password@localhost:27017/connectsphere_chat?authSource=admin

# Redis (Disposable cache & rate limiting)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ (Event broker topic exchange)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# MinIO (Local S3-compatible object storage for media)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=connectsphere-media

# Authentication (Placeholders for development only)
JWT_SECRET=dev_jwt_secret_key_minimum_32_characters_long_for_connectsphere
JWT_EXPIRES_IN=1d
